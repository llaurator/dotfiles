# macOS
.DS_Store

# Secrets / credentials
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# SSH: version only the generic config and empty examples.
ssh/.ssh/*
!ssh/.ssh/config
!ssh/.ssh/config.d/
ssh/.ssh/config.d/*
!ssh/.ssh/config.d/*.example

# Machine-local Git identity
git/.config/git/local.gitconfig
.config/git/local.gitconfig

# Local dotfiles state
.config/dotfiles/profile
.config/dotfiles/config

# Editors / temp
*.swp
*.swo
*~
.idea/
.vscode/

# Python
__pycache__/
*.pyc
